# Copy this file to .env and adjust as needed.
# See README.md section 16 "Environment variables" for full descriptions.

# Matches docker-compose.yml (host port 6543, not the Postgres default 5432).
DATABASE_URL=postgresql://marketpulse:marketpulse@localhost:6543/marketpulse

# "demo"  = deterministic synthetic data, no network/API key needed.
# "yahoo" = live NSE quotes via Yahoo Finance's free public chart endpoint
#           (best-effort, unofficial — see providers/YahooMarketDataProvider.ts).
MARKET_DATA_MODE=yahoo

PORT=4877

# Comma-separated list of allowed frontend origins.
CORS_ORIGIN=http://localhost:5544
